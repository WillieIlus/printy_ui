# Printy frontend - localhost development template.
#
# OPTIONAL: if you do NOT set NUXT_PUBLIC_API_BASE_URL, local development uses
# the same-origin Nitro dev proxy (browser -> http://localhost:3000/api/** ->
# Django). This avoids browser CORS entirely. The proxy target defaults to
# http://127.0.0.1:8000 and can be overridden with NUXT_PROXY_TARGET.
#
# NUXT_PUBLIC_API_BASE_URL is only needed to bypass the proxy and talk to
# Django directly from the browser (requires CORS on the Django side).

# NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
# NUXT_PROXY_TARGET=http://127.0.0.1:8000
NUXT_PUBLIC_SITE_URL=http://localhost:3000
